<?xml version="1.0" encoding="UTF-8" ?>
<!-- safety·motor 유닛 전용 FastDDS 프로파일: 공유메모리 없이 UDP 만 쓴다.
     2026-11-14 주행 묶음을 내릴 때 safety_supervisor_node 가 영구히 멈췄다. 끝난 Nav2 프로세스의
     공유메모리 포트 잠금을 기다리다 /cmd_vel_safe 발행까지 막혔다. UDP 는 받는 쪽 잠금을 잡지 않는다.
     scripts/vica_terminator_layout.py 가 유닛 실행 스크립트에서 FASTRTPS_DEFAULT_PROFILES_FILE 로 지정한다. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>udp_only</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
